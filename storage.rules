rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /listingPhotos/{ownerUid}/{listingId}/{fileName} {
      // Property pictures are public because listings are publicly viewable.
      allow read: if true;

      // Only the authenticated owner can upload or replace an image in their folder.
      allow create, update: if request.auth != null
                            && request.auth.uid == ownerUid
                            && request.resource != null
                            && request.resource.size <= 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');

      // Only the authenticated owner can remove their photo.
      allow delete: if request.auth != null && request.auth.uid == ownerUid;
    }
  }
}
